{
  "name": "azzurro-review-insights",
  "version": "1.0.0",
  "private": true,
  "description": "Collects Booking.com guest reviews for four Azzurro Hotels properties and turns them into an operations dashboard.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup:browser": "playwright install chromium",
    "scrape": "node scraper/run.js",
    "scrape:full": "node scraper/run.js --full",
    "import": "node scraper/import.js",
    "seed": "node scraper/import.js data/raw/*.json",
    "classify": "node scraper/classify.js",
    "eval": "node scraper/evaluate.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "mongodb": "^6.20.0",
    "next": "16.4.2",
    "playwright": "^1.55.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.2.1"
  }
}
